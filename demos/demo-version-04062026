function generarCursoData(curso, asignatura) {
  const basePorCurso = {
    '4a': 67, '4b': 72, '6a': 69, '6b': 65, '8a': 71, '8b': 68
  };
  const ajusteAsignatura = asignatura === 'len' ? 4 : 0;
  const base = basePorCurso[curso] + ajusteAsignatura;
  const total = totalPreguntasCurso(curso, asignatura);

  return Array.from({length:45}, (_,i) => {
    const variacion = ((i * 7) % 31) - 15;
    const logro = Math.max(38, Math.min(94, base + variacion));
    const correctas = Math.round((logro / 100) * total);
    return [logro, correctas, total];
  });
}

