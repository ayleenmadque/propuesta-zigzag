<style>
:root {
  --rojo: #E24B4A;
  --rojo-light: #FCEBEB;
  --rojo-dark: #A32D2D;
  --azul: #185FA5;
  --azul-light: #E6F1FB;
  --verde: #2E7D32;
  --verde-light: #FAFDF9;
  --verde-dark: #2E7D32;
  --verde-mid: #A8D59E;
  --verde-soft: #FAFDF9;
  --verde-border: #7FBF73;
  --amber: #854F0B;
  --amber-light: #FAEEDA;
  --gris: #F7F7F5;
  --gris-borde: #E5E5E3;
  --texto: #1A1A1A;
  --texto-sec: #6B6B67;
  --blanco: #FFFFFF;
  --serif: 'DM Serif Display', serif;
  --sans: 'DM Sans', sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: var(--sans); color: var(--texto); background: var(--blanco); font-size: 15px; line-height: 1.6; }

/* NAV */
nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); border-bottom: 1px solid var(--gris-borde); padding: 0 48px; display: flex; align-items: center; justify-content: space-between; height: 60px; }
.nav-logo { display: flex; align-items: center; gap: 10px; font-family: var(--sans); font-weight: 600; font-size: 14px; color: var(--texto); text-decoration: none; }
.nav-zz { width: 30px; height: 30px; background: var(--rojo); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: white; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; }
.nav-sep { color: var(--gris-borde); font-weight: 300; margin: 0 4px; }
.nav-links { display: flex; gap: 32px; }
.nav-links a { font-size: 13px; color: var(--texto-sec); text-decoration: none; font-weight: 400; transition: color 0.2s; }
.nav-links a:hover { color: var(--rojo); }
.nav-cta { background: var(--rojo); color: white; font-size: 13px; font-weight: 500; padding: 8px 20px; border-radius: 8px; text-decoration: none; transition: background 0.2s; }
.nav-cta:hover { background: var(--rojo-dark); }

/* HERO */
.hero { min-height: 100vh; display: flex; align-items: center; padding: 120px 48px 80px; background: var(--blanco); position: relative; overflow: hidden; }
.hero::before { content: ''; position: absolute; top: -100px; right: -200px; width: 700px; height: 700px; background: radial-gradient(circle, #FCEBEB 0%, transparent 70%); border-radius: 50%; pointer-events: none; }
.hero-content { max-width: 620px; position: relative; z-index: 1; }
.hero-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 500; color: var(--rojo); background: var(--rojo-light); padding: 6px 14px; border-radius: 100px; margin-bottom: 28px; letter-spacing: 0.3px; }
.hero-eyebrow-dot { width: 6px; height: 6px; background: var(--verde-mid); border-radius: 50%; }
h1 { font-family: var(--serif); font-size: clamp(40px, 5vw, 60px); line-height: 1.1; color: var(--texto); margin-bottom: 24px; font-weight: 400; }
h1 em { color: var(--rojo); font-style: italic; }
.hero-desc { font-size: 17px; color: var(--texto-sec); line-height: 1.7; margin-bottom: 40px; max-width: 520px; font-weight: 300; }
.hero-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
.btn-primary { background: var(--rojo); color: white; padding: 14px 28px; border-radius: 10px; text-decoration: none; font-weight: 500; font-size: 14px; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
.btn-primary:hover { background: var(--rojo-dark); transform: translateY(-1px); }
.btn-secondary { color: var(--texto); padding: 14px 28px; border-radius: 10px; text-decoration: none; font-weight: 400; font-size: 14px; border: 1px solid var(--gris-borde); transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
.btn-secondary:hover { border-color: var(--rojo); color: var(--rojo); }
.hero-visual { position: absolute; right: 48px; top: calc(50% - 3cm); transform: translateY(-50%); width: 460px; }
.hero-card { background: white; border: 1px solid var(--gris-borde); border-radius: 16px; padding: 24px; box-shadow: 0 4px 32px rgba(0,0,0,0.06); }
.hero-card-header { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
.hero-card-dot { width: 10px; height: 10px; border-radius: 50%; }
.hero-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
.hero-metric { background: var(--gris); border-radius: 10px; padding: 14px; }
.hero-metric-label { font-size: 11px; color: var(--texto-sec); margin-bottom: 4px; }
.hero-metric-value { font-size: 22px; font-weight: 500; }
.hero-bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.hero-bar-label { font-size: 11px; color: var(--texto-sec); width: 80px; flex-shrink: 0; }
.hero-bar-track { flex: 1; height: 6px; background: var(--gris); border-radius: 3px; overflow: hidden; }
.hero-bar-fill { height: 100%; border-radius: 3px; }
.hero-bar-val { font-size: 11px; font-weight: 500; width: 32px; text-align: right; }

/* SECTIONS */
section { padding: 96px 48px; }
.section-eyebrow { font-size: 12px; font-weight: 500; color: var(--rojo); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; }
h2 { font-family: var(--serif); font-size: clamp(28px, 3.5vw, 42px); line-height: 1.15; font-weight: 400; margin-bottom: 20px; }
.section-desc { font-size: 16px; color: var(--texto-sec); max-width: 560px; line-height: 1.7; font-weight: 300; }
.divider { width: 48px; height: 3px; background: var(--verde-mid); border-radius: 2px; margin: 20px 0; }

/* CONTEXTO */
.contexto { background: var(--gris); }
.contexto-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
.contexto-text p { font-size: 15px; color: var(--texto-sec); line-height: 1.8; margin-bottom: 16px; font-weight: 300; }
.contexto-cards { display: flex; flex-direction: column; gap: 14px; }
.ctx-card { background: white; border-radius: 12px; padding: 20px; border-left: 3px solid var(--rojo); }
.ctx-card-title { font-size: 13px; font-weight: 600; color: var(--texto); margin-bottom: 6px; }
.ctx-card-desc { font-size: 13px; color: var(--texto-sec); line-height: 1.6; }

/* FICHA */
.ficha-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
.ficha-item { border: 1px solid var(--gris-borde); border-radius: 14px; padding: 24px; transition: border-color 0.2s; }
.ficha-item:hover { border-color: var(--rojo); }
.ficha-icon { width: 40px; height: 40px; background: var(--rojo-light); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; color: var(--rojo); font-size: 18px; }
.ficha-label { font-size: 11px; font-weight: 500; color: var(--texto-sec); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
.ficha-value { font-size: 15px; font-weight: 500; color: var(--texto); line-height: 1.4; }

/* ETAPAS */
.etapas { background: var(--gris); }
.etapas-list { display: flex; flex-direction: column; gap: 0; margin-top: 40px; position: relative; }
.etapas-list::before { content: ''; position: absolute; left: 23px; top: 0; bottom: 0; width: 1px; background: var(--gris-borde); }
.etapa { display: flex; gap: 24px; align-items: flex-start; padding: 0 0 36px; position: relative; }
.etapa:last-child { padding-bottom: 0; }
.etapa-num { width: 48px; height: 48px; border-radius: 50%; background: white; border: 2px solid var(--rojo); display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-size: 18px; color: var(--rojo); flex-shrink: 0; position: relative; z-index: 1; }
.etapa-body { flex: 1; background: white; border-radius: 14px; padding: 22px 24px; border: 1px solid var(--gris-borde); }
.etapa-title { font-size: 15px; font-weight: 600; color: var(--texto); margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; }
.etapa-badge { font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 100px; }
.etapa-desc { font-size: 13px; color: var(--texto-sec); line-height: 1.7; margin-bottom: 12px; }
.etapa-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.tag { font-size: 11px; padding: 3px 10px; border-radius: 100px; background: var(--gris); color: var(--texto-sec); border: 1px solid var(--gris-borde); }

/* SOLUCIÓN PORTAL */
.solucion-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-top: 40px; }
.solucion-features { display: flex; flex-direction: column; gap: 20px; }
.feat { display: flex; gap: 16px; align-items: flex-start; }
.feat-icon { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 16px; }
.feat-title { font-size: 14px; font-weight: 600; color: var(--texto); margin-bottom: 4px; }
.feat-desc { font-size: 13px; color: var(--texto-sec); line-height: 1.6; }
.portal-preview { background: white; border: 1px solid var(--gris-borde); border-radius: 16px; overflow: hidden; box-shadow: 0 8px 48px rgba(0,0,0,0.08); }
.portal-bar { background: var(--gris); border-bottom: 1px solid var(--gris-borde); padding: 10px 16px; display: flex; align-items: center; gap: 8px; }
.portal-dot { width: 10px; height: 10px; border-radius: 50%; }
.portal-url { font-size: 11px; color: var(--texto-sec); background: white; border: 1px solid var(--gris-borde); border-radius: 4px; padding: 3px 10px; flex: 1; text-align: center; }
.portal-body { padding: 16px; }
.portal-header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; border-bottom: 1px solid var(--gris-borde); padding-bottom: 10px; }
.portal-logo { width: 20px; height: 20px; background: var(--verde-mid); border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 7px; font-weight: 700; color: white; }
.portal-nav-items { display: flex; gap: 12px; }
.portal-nav-item { font-size: 10px; color: var(--texto-sec); padding: 3px 8px; border-radius: 4px; }
.portal-nav-item.active { background: var(--rojo-light); color: var(--rojo); font-weight: 500; }
.mini-metrics { display: grid; grid-template-columns: repeat(4,1fr); gap: 6px; margin-bottom: 10px; }
.mini-metric { background: var(--gris); border-radius: 6px; padding: 8px; }
.mini-metric-l { font-size: 9px; color: var(--texto-sec); }
.mini-metric-v { font-size: 15px; font-weight: 500; }
.mini-chart-placeholder { background: var(--gris); border-radius: 8px; height: 80px; display: flex; align-items: flex-end; justify-content: center; gap: 4px; padding: 10px; }
.mini-bar { border-radius: 3px 3px 0 0; width: 14px; }

/* DEMO */
.demo-section { background: var(--gris); }
.demo-wrap { margin-top: 40px; background: white; border: 1px solid var(--gris-borde); border-radius: 20px; overflow: hidden; box-shadow: 0 4px 40px rgba(0,0,0,0.06); }
.demo-topbar { background: white; border-bottom: 1px solid var(--gris-borde); padding: 0 24px; display: flex; align-items: center; justify-content: space-between; height: 52px; }
.demo-logo { display: flex; align-items: center; gap: 8px; }
.demo-logo-zz { width: 28px; height: 28px; background: var(--verde-mid); border-radius: 5px; display: flex; align-items: center; justify-content: center; color: white; font-size: 9px; font-weight: 700; }
.demo-logo-text { font-size: 13px; font-weight: 500; color: var(--texto); }
.demo-nav { display: flex; gap: 0; }
.demo-nav-item { font-size: 12px; color: var(--texto-sec); padding: 0 14px; height: 52px; display: flex; align-items: center; border-bottom: 2px solid transparent; cursor: pointer; transition: all 0.2s; }
.demo-nav-item:hover { color: var(--rojo); }
.demo-nav-item.active { color: var(--rojo); border-bottom-color: var(--rojo); font-weight: 500; }
.demo-user { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--texto-sec); }
.demo-avatar { width: 26px; height: 26px; border-radius: 50%; background: var(--rojo-light); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; color: var(--rojo-dark); }
.demo-body { display: flex; min-height: 460px; }
.demo-sidebar { width: 176px; background: white; border-right: 1px solid var(--gris-borde); padding: 16px 0; flex-shrink: 0; }
.demo-sidebar-title { font-size: 10px; font-weight: 500; color: #aaa; padding: 0 16px 8px; text-transform: uppercase; letter-spacing: 0.5px; }
.demo-sidebar-item { display: flex; align-items: center; gap: 8px; padding: 8px 16px; font-size: 12px; color: var(--texto-sec); cursor: pointer; border-left: 2px solid transparent; transition: all 0.15s; }
.demo-sidebar-item:hover { background: var(--rojo-light); color: var(--rojo); }
.demo-sidebar-item.active { background: var(--rojo-light); color: var(--rojo); border-left-color: var(--rojo); font-weight: 500; }
.demo-content { flex: 1; padding: 20px 24px; background: #FAFAF8; overflow: hidden; }
.demo-breadcrumb { font-size: 11px; color: #aaa; margin-bottom: 10px; }
.demo-breadcrumb span { color: var(--rojo); }
.demo-page-title { font-size: 16px; font-weight: 600; color: var(--texto); margin-bottom: 3px; }
.demo-page-sub { font-size: 12px; color: var(--texto-sec); margin-bottom: 16px; }
.demo-badge { display: inline-block; font-size: 10px; padding: 2px 8px; border-radius: 4px; font-weight: 500; background: var(--rojo-light); color: var(--rojo-dark); margin-left: 8px; }
.d-metrics { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin-bottom: 14px; }
.d-metric { background: white; border: 1px solid var(--gris-borde); border-radius: 8px; padding: 12px; }
.d-metric-l { font-size: 10px; color: var(--texto-sec); margin-bottom: 4px; }
.d-metric-v { font-size: 20px; font-weight: 500; color: var(--texto); }
.d-bi-nav { display: flex; gap: 0; border-bottom: 1px solid var(--gris-borde); margin-bottom: 14px; }
.d-bi-btn { padding: 6px 14px; font-size: 12px; background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer; color: var(--texto-sec); margin-bottom: -1px; transition: all 0.2s; }
.d-bi-btn.active { border-bottom-color: var(--rojo); color: var(--rojo); font-weight: 500; }
.d-charts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
.d-chart-card { background: white; border: 1px solid var(--gris-borde); border-radius: 10px; padding: 14px; }
.d-chart-title { font-size: 11px; font-weight: 500; color: var(--texto-sec); margin-bottom: 8px; }
.d-legend { display: flex; gap: 12px; font-size: 10px; color: var(--texto-sec); margin-bottom: 6px; flex-wrap: wrap; }
.d-legend span { display: flex; align-items: center; gap: 4px; }
.d-legend-dot { width: 7px; height: 7px; border-radius: 2px; }
.d-panel { display: none; } .d-panel.active { display: block; }
.d-filter-row { display: flex; gap: 6px; margin-bottom: 10px; }
.d-filter-row select { font-size: 11px; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--gris-borde); background: white; color: var(--texto); cursor: pointer; }
table { width: 100%; border-collapse: collapse; font-size: 11px; }
th { background: var(--gris); font-weight: 500; font-size: 10px; color: var(--texto-sec); padding: 7px 10px; text-align: left; border-bottom: 1px solid var(--gris-borde); }
td { padding: 7px 10px; border-bottom: 1px solid #F0F0EE; color: var(--texto); }
.b-green { display:inline-block;font-size:10px;padding:2px 7px;border-radius:4px;font-weight:500;background:#2E7D32;color:#FFFFFF; }
.b-amber { display:inline-block;font-size:10px;padding:2px 7px;border-radius:4px;font-weight:500;background:var(--verde-mid);color:#245B21;border:1px solid var(--verde-mid); }
.b-red { display:inline-block;font-size:10px;padding:2px 7px;border-radius:4px;font-weight:500;background:var(--verde-soft);color:#2F5F2D;border:2px solid var(--verde-border); }

/* INCLUYE */
.incluye-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 40px; }
.incluye-item { display: flex; gap: 16px; align-items: flex-start; padding: 22px; border: 1px solid var(--gris-borde); border-radius: 14px; background: white; transition: border-color 0.2s; }
.incluye-item:hover { border-color: var(--rojo); }
.incluye-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
.incluye-title { font-size: 14px; font-weight: 600; color: var(--texto); margin-bottom: 4px; }
.incluye-desc { font-size: 13px; color: var(--texto-sec); line-height: 1.6; }

/* CONTACT */
.contact { background: var(--texto); color: white; }
.contact h2 { color: white; }
.contact .section-desc { color: rgba(255,255,255,0.6); }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 40px; align-items: start; }
.contact-info { display: flex; flex-direction: column; gap: 16px; }
.contact-item { display: flex; gap: 14px; align-items: flex-start; }
.contact-icon { width: 36px; height: 36px; border-radius: 8px; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; color: white; }
.contact-item-label { font-size: 11px; color: rgba(255,255,255,0.5); margin-bottom: 3px; }
.contact-item-value { font-size: 14px; color: white; font-weight: 400; }
.contact-note { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 24px; }
.contact-note-title { font-size: 14px; font-weight: 600; color: white; margin-bottom: 8px; }
.contact-note-desc { font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.7; }
.contact-note-list { list-style: none; margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
.contact-note-list li { font-size: 13px; color: rgba(255,255,255,0.7); display: flex; gap: 8px; align-items: flex-start; }
.contact-note-list li::before { content: '→'; color: var(--rojo); flex-shrink: 0; margin-top: 1px; }

/* FOOTER */
footer { background: #111; padding: 28px 48px; display: flex; align-items: center; justify-content: space-between; }
.footer-left { display: flex; align-items: center; gap: 20px; }
.footer-logo { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.7); }
.footer-zz { width: 24px; height: 24px; background: var(--verde-mid); border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: 700; color: white; }
.footer-sep { color: rgba(255,255,255,0.2); }
.footer-right { font-size: 12px; color: rgba(255,255,255,0.3); }

/* ANIMATIONS */
@keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.hero-content > * { animation: fadeUp 0.6s ease both; }
.hero-eyebrow { animation-delay: 0.1s; }
h1 { animation-delay: 0.2s; }
.hero-desc { animation-delay: 0.3s; }
.hero-actions { animation-delay: 0.4s; }
.hero-visual { animation: fadeUp 0.8s 0.3s ease both; }

.sv-panel { display: none; } .sv-panel.active { display: block; }
.dpanel { display: none; } .dpanel.active { display: block; }
.dtab { display: none; } .dtab.active { display: block; }
.dsi { display:flex;align-items:center;gap:6px;padding:7px 14px;font-size:11px;color:#666;cursor:pointer;border-left:2px solid transparent;transition:all 0.15s; }
.dsi:hover { background:#FFF5F5;color:#E24B4A; }
.dsi.active { background:#FCEBEB;color:#A32D2D;border-left-color:#E24B4A;font-weight:500; }
.dmc { background:white;border:1px solid var(--gris-borde);border-radius:8px;padding:10px; }
.dml { font-size:9px;color:#888;margin-bottom:3px; }
.dmv { font-size:18px;font-weight:500;color:var(--texto); }
.dbb { padding:5px 12px;font-size:11px;background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;color:#888;margin-bottom:-1px; }
.dbb.active { border-bottom-color:#E24B4A;color:#E24B4A;font-weight:500; }
.dcc { background:white;border:1px solid var(--gris-borde);border-radius:8px;padding:12px; }
.dct { font-size:10px;font-weight:500;color:#888;margin-bottom:6px; }
.dtbl { width:100%;border-collapse:collapse;font-size:11px; }
.dtbl th { background:#F7F7F5;font-weight:500;font-size:10px;color:#888;padding:6px 8px;text-align:left;border-bottom:1px solid var(--gris-borde); }
.dtbl td { padding:6px 8px;border-bottom:1px solid #F0F0EE;color:var(--texto); }
