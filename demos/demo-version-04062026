  if(preguntaCriticaEl) preguntaCriticaEl.textContent = 'P' + minPregunta + ' · ' + minValor + '%';

  const preguntaMejorEl = document.getElementById('curso-preg-mejor');
  if(preguntaMejorEl) preguntaMejorEl.textContent = 'P' + maxPregunta + ' · ' + maxValor + '%';

  document.getElementById('curso-tbody').innerHTML = data.map((r,i) =>
    `<tr><td>Estudiante ${String(i+1).padStart(2,'0')}</td><td>${r[0]}%</td><td>${r[1]} / ${r[2]}</td><td>${nivel(r[0])}</td></tr>`
  ).join('');
}

function rdp(){
  const a=document.getElementById('dfa').value;
  const n=document.getElementById('dfn').value;
  const tipo=document.getElementById('dft') ? document.getElementById('dft').value : 'todas';
  const colegio=document.getElementById('dfc') ? document.getElementById('dfc').value : 'todos';
  const colegioNombre=(colegiosFiltro[colegio] || colegiosFiltro.todos).nombre;
  const dataOriginal=pregs[a][n].map((v,i)=>ajustarPorColegio(v, colegio, i));
  const meta=metaPreguntas[a][n];
  const nombreAsignatura=a==='mat'?'Matemática':'Lenguaje';
  const nombreNivel={'4b':'4° básico','6b':'6° básico','8b':'8° básico'}[n];
  const preguntas=dataOriginal.map((valor,i)=>({
    numero:i+1,
    valor,
    tipo:(i+1)===meta.abierta?'abierta':'cerrada',
    oa:meta.oa[i % meta.oa.length],
    eje:meta.ejes[i % meta.ejes.length],
    hd:habDisc[a][i % habDisc[a].length],
    hc:habCog[a][i % habCog[a].length]
  }));
  const filtradas=preguntas.filter(q => tipo==='todas' || q.tipo===tipo);
  document.getElementById('dpt').textContent=`Logro por pregunta — ${nombreAsignatura} ${nombreNivel} · ${colegioNombre} · ${dataOriginal.length} preguntas`;
  const filtroLabel=document.getElementById('filtro-colegio-label');
  if(filtroLabel){
    filtroLabel.textContent = colegio === 'todos' ? 'Mostrando resultados consolidados de la red.' : `Mostrando resultados del establecimiento: ${colegioNombre}.`;
  }
  if(cp) cp.destroy();
  cp=new Chart(document.getElementById('dc3'),{
    type:'bar',
    data:{labels:filtradas.map(q=>'P'+q.numero),datasets:[{data:filtradas.map(q=>q.valor),backgroundColor:filtradas.map(q=>colorLogro(q.valor)),borderColor:filtradas.map(q=>bordeLogro(q.valor)),borderWidth:filtradas.map(q=>anchoBordeLogro(q.valor))}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>`${ctx.raw}% · ${nivelNombre(ctx.raw)}`}}},scales:{x:{ticks:{font:{size:9},autoSkip:filtradas.length>22},grid:{display:false}},y:{min:0,max:100,ticks:{callback:v=>v+'%',font:{size:9}}}}}
  });
  const tbody=document.getElementById('dpreg-tbody');
  if(tbody){
    tbody.innerHTML=filtradas.map(q=>`<tr><td>P${q.numero}</td><td>${q.tipo==='abierta'?'Abierta':'Cerrada'}</td><td>${q.oa}</td><td>${q.hd}</td><td>${q.hc}</td><td>${nivelBadge(q.valor)}</td></tr>`).join('');
  }
  const detalleCount=document.getElementById('detalle-preguntas-count');
  if(detalleCount){
    detalleCount.textContent = `${filtradas.length} de ${dataOriginal.length} preguntas`;
  }
  const detalleNote=document.getElementById('detalle-preguntas-note');
  if(detalleNote){
    detalleNote.textContent = tipo === 'todas'
      ? 'Mostrando todas las preguntas del instrumento. Desplázate para ver el resto.'
      : `Mostrando preguntas ${tipo === 'abierta' ? 'abiertas' : 'cerradas'} del instrumento. Desplázate para ver el resto.`;
  }
  const abierta=preguntas.find(q=>q.tipo==='abierta');
  const detail=document.getElementById('open-question-detail');
  if(detail){
    // Indicadores de logro por asignatura para la pregunta abierta.
    // Matemática posee 3 indicadores; Lenguaje posee 9 indicadores.
    const indicadoresAbiertas = {
      mat: [
        'Indicador 1: Planteamiento y Procedimiento',
        'Indicador 2: Resultado Correcto',
        'Indicador 3: Respuesta Completa y Argumentada'
      ],
      len: [
        'Indicador 1: comprende el propósito',
        'Indicador 2: plantea una idea central',
        'Indicador 3: argumenta',
        'Indicador 4: usa evidencia',
        'Indicador 5: relaciona información',
        'Indicador 6: mantiene coherencia',
        'Indicador 7: usa vocabulario pertinente',
        'Indicador 8: respeta género discursivo',
        'Indicador 9: cierra la respuesta'
      ]
    };
    const indicadores = indicadoresAbiertas[a] || indicadoresAbiertas.len;
    detail.innerHTML=`
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:8px;">
        <div>
          <strong>Pregunta abierta detectada: P${abierta.numero}</strong><br>
          <span style="color:#777;">${a==='len'?'Lenguaje':'Matemática'} · ${nombreNivel}</span>
        </div>
        <span class="${abierta.valor>=80?'bg':(abierta.valor>=60?'ba':'br')}">${abierta.valor}% · ${nivelNombre(abierta.valor)}</span>
      </div>
      <div style="margin-bottom:8px;"><strong>Foco de análisis:</strong><br>${a==='len'?'Lectura, reflexión, escritura, producción temática y género discursivo.':'Planteamiento, procedimiento, resultado correcto, respuesta completa y argumentada.'}</div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;">
        <strong>Indicadores asociados:</strong>
        <span style="font-size:9px;color:#777;">${indicadores.length} indicadores</span>
      </div>
      <div style="max-height:105px;overflow-y:auto;padding-right:4px;display:flex;flex-direction:column;gap:4px;">
        ${indicadores.map(x=>`<div style="padding:4px 6px;background:#fff;border:1px solid #E9E9E5;border-radius:5px;">${x}</div>`).join('')}
      </div>`;
  }
}

function dShow(id,el){
  document.querySelectorAll('.dpanel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.dsi').forEach(i=>i.classList.remove('active'));
  const panel = document.getElementById('dp-'+id);
  if(!panel) return;
  panel.classList.add('active');
  el.classList.add('active');
  if(id==='res') initResumen();
  if(id==='cole'){ initC4(); initC5(); }
}

window.addEventListener('load', function(){
  initResumen();
  renderCurso();
  rdp();
});

function dTab(id,btn){
  document.querySelectorAll('.dtab').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.dbb').forEach(b=>b.classList.remove('active'));
  document.getElementById('dt-'+id).classList.add('active');
  btn.classList.add('active');
}
</script>
</body>
</html>
